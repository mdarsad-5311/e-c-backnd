# Django Core Settings
SECRET_KEY=your-production-secret-key-at-least-50-chars-random-string
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com,.onrender.com,.vercel.app

# CORS & CSRF Settings (Comma-separated origins for Next.js / frontend apps)
CORS_ALLOWED_ORIGINS=https://e-com-five-pink.vercel.app,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://e-com-five-pink.vercel.app,http://localhost:3000

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_live_or_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email Configuration (for password reset / transactional emails)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_smtp_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Production Security Flags (Optional Overrides)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
